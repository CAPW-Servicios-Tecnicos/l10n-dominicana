<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <template id="custom_header">
        <div style="margin-bottom: 0;">
            <div class="row">
                <div class="col-5" style="padding-top: 0;">
                    <img t-if="o.company_id.logo"
                         t-att-src="image_data_uri(o.company_id.logo)"
                         style="max-height: 70px; max-width: 220px; width: auto; display: block;"
                         alt="Logo"/>
                </div>

                <div class="col-7 text-end" style="padding-top: 0; line-height: 1.15; font-size: 11.5px;">
                    <div t-if="o.company_id.partner_id.name">
                        <strong t-field="o.company_id.partner_id.name"/>
                    </div>
                    <div t-if="o.company_id.vat">
                        <strong>RNC:</strong>
                        <span t-field="o.company_id.vat"/>
                    </div>
                    <div t-if="o.company_id.partner_id.street">
                        <span t-field="o.company_id.partner_id"
                              t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                    </div>
                    <div t-if="o.company_id.phone or o.company_id.partner_id.phone">
                        <strong>Tel.:</strong>
                        <span t-out="o.company_id.phone or o.company_id.partner_id.phone"/>
                    </div>
                    <div t-if="o.company_id.email or o.company_id.partner_id.email">
                        <strong>Email:</strong>
                        <span t-out="o.company_id.email or o.company_id.partner_id.email"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="informations">
        <div id="informations" class="row" style="clear: both; margin-top: 10px; margin-bottom: 12px;">
            <div class="col-6" style="line-height: 1.45; font-size: 13px;">
                <t t-set="vat_len" t-value="len(o.commercial_partner_id.vat) if o.commercial_partner_id.vat else 0"/>

                <div>
                    <strong>
                        <t t-if="vat_len == 9">RNC:</t>
                        <t t-elif="vat_len == 11">Cédula:</t>
                        <t t-else="">ID Cliente:</t>
                    </strong>
                    <span t-out="o.commercial_partner_id.vat or ''"/>
                </div>

                <div>
                    <strong>
                        <t t-if="vat_len == 9">Razón Social:</t>
                        <t t-else="">Nombre:</t>
                    </strong>
                    <span t-field="o.partner_id.name"/>
                </div>

                <div t-if="o.partner_id.phone">
                    <strong>Tel.:</strong>
                    <span t-field="o.partner_id.phone"/>
                </div>

                <div t-if="o.invoice_origin">
                    <strong>Origen:</strong>
                    <span t-field="o.invoice_origin"/>
                </div>

                <div t-if="o.ref">
                    <strong>Referencia:</strong>
                    <span t-field="o.ref"/>
                </div>
            </div>

            <div class="col-6 text-end" style="line-height: 1.55; font-size: 13px;">
                <h2 style="margin: 0 0 12px 0; font-size: 26px; line-height: 1.15;">
                    <span t-field="o.l10n_latam_document_type_id.report_name"/>
                </h2>

                <div t-if="o.l10n_do_fiscal_number" style="margin-bottom: 10px;">
                    <strong>
                        <t t-if="ecf_representation">e-NCF:</t>
                        <t t-else="">NCF:</t>
                    </strong>
                    <span t-field="o.l10n_do_fiscal_number"/>
                </div>

                <div t-if="(o.move_type == 'out_refund' or o.move_type == 'in_refund' or o.debit_origin_id) and (o.l10n_do_origin_ncf != False)">
                    <strong>NCF modificado:</strong>
                    <span t-field="o.l10n_do_origin_ncf"/>
                    <t t-if="ecf_representation">
                        <br/>
                        <strong>Código Modificación:</strong>
                        <span t-field="o.l10n_do_ecf_modification_code"/>
                    </t>
                </div>

                <div t-if="o.l10n_latam_use_documents
               and o.move_type in ['out_invoice', 'out_refund']
               and o.state == 'posted'
               and o.l10n_do_fiscal_number
               and o.l10n_latam_document_type_id
               and o.l10n_latam_document_type_id.doc_code_prefix[1:] not in ('32', '34', '02')">
                    <strong>
                        <t t-if="ecf_representation">Vencimiento e-NCF:</t>
                        <t t-else="">Válida hasta:</t>
                    </strong>
                    <span t-field="o.l10n_do_ncf_expiration_date"/>
                </div>

                <div>
                    <strong>Fecha Emisión:</strong>
                    <span t-field="o.invoice_date"/>
                </div>

                <div t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted' and not ecf_representation">
                    <strong>Vence:</strong>
                    <span t-field="o.invoice_date_due"/>
                </div>

                <div t-if="is_l10n_do_invoice" class="text-muted" style="margin-top: 10px;">
                    <span>
                        <strong>Original:</strong>
                        Cliente
                    </span>
                    <br/>
                    <span>
                        <strong>Copia:</strong>
                        Vendedor
                    </span>
                </div>
            </div>
        </div>
    </template>

    <template id="document_tax_totals">

        <t t-set="l10n_do_amounts" t-value="o._get_l10n_do_amounts()"/>
        <t t-set="tax_totals" t-value="o.tax_totals"/>
        <t t-set="currency" t-value="o.currency_id"/>

        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
            <tr class="border-black o_subtotal">
                <td>
                    <strong t-out="subtotal['name']"/>
                </td>
                <td class="text-end">
                    <span t-att-class="oe_subtotal_footer_separator" t-out="subtotal['base_amount_currency']"
                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                </td>
            </tr>
        </t>

        <!-- Desglose de impuestos -->
        <t t-foreach="o.line_ids.filtered('tax_line_id')" t-as="tax_aml">
            <t t-set="l10n_do_tax_amount"
               t-value="abs(tax_aml.debit or tax_aml.credit if o.currency_id == o.company_id.currency_id else tax_aml.amount_currency)"/>
            <tr t-if="tax_aml.tax_line_id.amount > 0" style="">
                <t>
                    <td>
                        <span class="text-nowrap" t-out="tax_aml.tax_line_id.name"/>
                    </td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap" t-out="l10n_do_tax_amount"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </t>
            </tr>
        </t>

        <t t-set="total_amount_taxed"
           t-value="l10n_do_amounts['itbis_18_base_amount'] + l10n_do_amounts['itbis_16_base_amount'] + l10n_do_amounts['itbis_0_base_amount']"/>
        <t t-set="total_exempt_amount" t-value="l10n_do_amounts['exempt_amount']"/>

        <tr class="border-black o_total" t-if="ecf_representation">
            <td>Monto Gravado</td>
            <td class="text-end o_price_total">
                <!-- MontoGravadoTotal consiste en la suma de la base imponible de todas las lineas gravadas con ITBIS -->
                <span class="text-nowrap" t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                      t-out="total_amount_taxed"/>
            </td>
        </tr>
        <tr t-if="ecf_representation">
            <td>Monto Exento</td>
            <td class="text-end o_price_total">
                <!-- MontoExento consiste en la suma de la base imponible de todas las lineas exentas -->
                <span class="text-nowrap" t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                      t-out="total_exempt_amount"/>
            </td>
        </tr>

        <!-- Total = subtotal + impuestos + retenciones -->
        <tr class="border-black o_total">
            <td>
                <strong>Total</strong>
            </td>

            <t t-set="l10n_do_amount_total" t-value="l10n_do_amounts['l10n_do_invoice_total']"/>
            <td class="text-end">
                <span class="text-nowrap" t-out="l10n_do_amount_total"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
        </tr>

        <!-- Desglose de retenciones -->
        <t t-foreach="o.line_ids.filtered('tax_line_id')" t-as="tax_aml">
            <t t-set="l10n_do_wh_amount"
               t-value="tax_aml.debit or tax_aml.credit if o.currency_id == o.company_id.currency_id else tax_aml.amount_currency"/>
            <tr t-if="tax_aml.tax_line_id.amount &lt; 0" style="">
                <t>
                    <td>
                        <span class="text-nowrap" t-out="tax_aml.tax_line_id.name"/>
                    </td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap" t-out="l10n_do_wh_amount"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </t>
            </tr>
        </t>

    </template>

    <template id="report_invoice_document_inherited" inherit_id="account.report_invoice_document" primary="True">

        <t t-set="o" position="after">
            <t t-set="custom_header" t-value="'l10n_do_accounting.custom_header'"/>
            <t t-set="ecf_representation" t-value="o.is_ecf_invoice"/>
            <t t-set="is_l10n_do_invoice"
               t-value="o.l10n_latam_use_documents and o.company_id.country_id and o.country_code == 'DO'"/>
        </t>

        <t t-set="address" position="replace"/>
        <t t-set="layout_document_title" position="replace"/>

        <!-- replace information section and use dominican style -->
        <div id="informations" position="replace">
            <t t-call="l10n_do_accounting.informations"/>
        </div>

        <xpath expr="//table[hasclass('o_main_table')]/tbody//td[hasclass('o_price_total')]" position="inside">
            <t t-if="is_l10n_do_invoice and line.price_subtotal == line.price_total">
                <span>
                    <strong>E</strong>
                </span>
            </t>
        </xpath>

        <xpath expr="//div[@id='payment_term']" position="after">
            <div id="l10n_do_ecf_qr_placeholder"/>
        </xpath>

        <!-- Total monto descuento en líneas -->
        <xpath expr="//th[@name='th_discount']" position="after">
            <th t-if="is_l10n_do_invoice and display_discount and ecf_representation"
                t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Monto descuento</span>
            </th>
        </xpath>
        <xpath expr="//td[@t-if='display_discount']" position="after">
            <td t-if="is_l10n_do_invoice and display_discount and ecf_representation"
                t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <t t-set="discount_amount" t-value="line.price_unit * line.quantity * line.discount / 100"/>
                <span class="text-nowrap" t-out="discount_amount"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
        </xpath>
        <xpath expr="//span[@id='line_tax_ids']" position="attributes">
            <attribute name="t-out">', '.join(map(lambda x: (x.invoice_label or x.name).replace('Sales', '').strip(),
                line.tax_ids)) if not ecf_representation else '%s %s' % (o.currency_id.symbol,
                '{0:,.2f}'.format(line.l10n_do_itbis_amount))
            </attribute>
        </xpath>

        <xpath expr="//div[@id='total']/div/table/t[@t-call='account.document_tax_totals']" position="replace">
            <t t-call="l10n_do_accounting.document_tax_totals"/>
        </xpath>

    </template>

    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="replace">
            <t t-if="o._get_name_invoice_report() == 'l10n_do_accounting.report_invoice_document_inherited'"
               t-call="l10n_do_accounting.report_invoice_document_inherited" t-lang="lang"/>
            <t t-else=""
               t-call="account.report_invoice_document" t-lang="lang"/>
        </xpath>
    </template>

</odoo>
